# Personal Health Assistant backend settings. Copy to backend/.env and edit as needed.
# Every value must stay on this machine: host and Ollama URL are validated to be loopback.

# Address the API binds to (loopback only: 127.0.0.1, ::1, localhost)
PHA_HOST=127.0.0.1
PHA_PORT=8000

# Local Ollama server and the model to chat with: phi3-medquad-v2 (grounded fine-tune, default),
# phi3-base (unmodified baseline). Avoid phi3-medquad (v1): it ignores retrieved documents.
PHA_OLLAMA_URL=http://127.0.0.1:11434
PHA_MODEL=phi3-medquad-v2

# Local storage (defaults are under the repo's data/ and models/ directories)
# PHA_CHROMA_DIR=../data/chroma
# PHA_UPLOADS_DIR=../data/uploads
# PHA_EMBED_MODEL_DIR=../models/embeddings/bge-small-en-v1.5
# PHA_CHATS_PATH=../data/chats.db              # saved conversations (local SQLite)

# Privacy verification: refuse and log every non-loopback connection (used by the privacy test)
# PHA_NET_GUARD=1
# PHA_NET_GUARD_LOG=../data/netguard.log
